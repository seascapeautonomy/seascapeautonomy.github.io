---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sectors, type Sector } from '../../data/sectors';

export function getStaticPaths() {
  return sectors.map((sector) => ({ params: { slug: sector.slug }, props: { sector } }));
}

const { sector } = Astro.props as { sector: Sector };
---

<BaseLayout title={sector.name} description={sector.summary}>
  <section class="container intro">
    <p class="eyebrow">{sector.name}</p>
    <h1>{sector.tagline}</h1>
    <p class="lead">{sector.summary}</p>
  </section>

  <section class="container">
    <h2 data-reveal>Capabilities</h2>
    <ul class="capabilities">
      {sector.capabilities.map((capability) => <li data-reveal>{capability}</li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  .intro { padding-block: 9rem 3rem; }
  h1 { font-size: clamp(2.2rem, 6vw, 4.5rem); margin: 0.25em 0; max-width: 18ch; }
  .lead { color: var(--color-muted); max-width: 55ch; font-size: 1.15rem; }
  .capabilities { list-style: none; padding: 0; display: grid; gap: 1rem; padding-bottom: 5rem; }
  .capabilities li {
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
</style>
