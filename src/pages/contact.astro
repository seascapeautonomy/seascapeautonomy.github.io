---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { contact } from '../data/company';
---

<BaseLayout title="Contact" description="Get in touch with Seascape Autonomy about seafloor survey, inspection and AUV systems.">
  <section class="container contact">
    <div class="info">
      <p class="eyebrow">Contact</p>
      <h1>Let’s bring your seafloor into focus</h1>
      <p class="lead">
        Tell us about your survey, inspection or monitoring challenge and we’ll get back to you.
      </p>
      <dl>
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
        </div>
        <div>
          <dt>LinkedIn</dt>
          <dd><a href={contact.linkedin} target="_blank" rel="noopener">Seascape Autonomy</a></dd>
        </div>
      </dl>
    </div>
    <div class="form-card">
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    padding-block: 9rem 6rem;
  }
  @media (max-width: 900px) {
    .contact { grid-template-columns: 1fr; padding-top: 7rem; }
  }
  h1 { font-size: clamp(2.2rem, 5vw, 3.75rem); margin: 0.2em 0 0.4em; }
  .lead { color: var(--color-muted); font-size: 1.15rem; max-width: 40ch; margin: 0 0 2.5rem; }
  dl { margin: 0; display: grid; gap: 1.25rem; }
  dt { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-muted); }
  dd { margin: 0.25rem 0 0; font-size: 1.1rem; }
  dd a { text-decoration: none; }
  dd a:hover { color: var(--color-accent); }
  .form-card {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: calc(var(--radius) * 1.5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
</style>
