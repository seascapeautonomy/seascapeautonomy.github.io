---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

const links = [
  { href: '/sectors/defence', label: 'Defence' },
  { href: '/sectors/offshore', label: 'Offshore' },
  { href: '/sectors/environmental', label: 'Environmental' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="container inner">
    <a href="/" class="brand" aria-label="Seascape Autonomy home">
      <Image src={logo} alt="" height={40} />
      <span>Seascape Autonomy</span>
    </a>
    <nav aria-label="Main">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(12px);
    background: rgb(5 13 24 / 0.7);
    border-bottom: 1px solid var(--color-border);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
  }
  .brand img { width: auto; height: 40px; }
  nav { display: flex; gap: clamp(0.75rem, 2vw, 1.75rem); flex-wrap: wrap; }
  nav a { text-decoration: none; color: var(--color-muted); font-size: 0.95rem; }
  nav a:hover { color: var(--color-text); }
  @media (max-width: 640px) {
    .brand span { display: none; }
  }
</style>
