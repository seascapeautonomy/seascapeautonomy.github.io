---
import { Image } from 'astro:assets';
import hero from '../assets/hero.png';
import { vehicleStats } from '../data/company';

// Each headline word comes into focus in turn; each inner array is one line,
// and the second line takes the accent colour.
const lines = [
  ['Bringing', 'the', 'deep'],
  ['into', 'focus'],
];
let wordIndex = 0;
---

<section class="hero">
  <div class="hero-media">
    <Image
      src={hero}
      alt="Seeker AUV surveying a reef in Tonga"
      loading="eager"
      fetchpriority="high"
      widths={[800, 1400, 2000, 2304]}
      sizes="100vw"
    />
  </div>
  <div class="hero-shade"></div>

  <div class="container hero-content">
    <p class="eyebrow">Autonomous seafloor imaging</p>
    <h1>
      {
        lines.map((line, lineIndex) => (
          <span class:list={['line', { accent: lineIndex === lines.length - 1 }]}>
            {line.map((word) => (
              <span class="word" style={`--i: ${wordIndex++}`}>
                {word}
              </span>
            ))}
          </span>
        ))
      }
    </h1>
    <p class="lead">
      See clearly, decide confidently. Portable, hover-capable AUVs delivering high-resolution seafloor
      imaging and sonar data for defence, offshore infrastructure and environmental survey.
    </p>
    <div class="actions">
      <a class="button" href="#sectors">Explore capabilities</a>
      <a class="button ghost" href="/contact">Talk to us</a>
    </div>
  </div>

  <dl class="container vehicle-stats">
    {
      vehicleStats.map((stat, i) => (
        <div style={`--i: ${i}`}>
          <dt>{stat.label}</dt>
          <dd>{stat.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-content: end;
    overflow: hidden;
    color: #f2f7fb; /* sits on the photo, so stays light */
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Mirrored so the AUV sits on the right, heading towards the headline. */
    transform: scaleX(-1);
    object-position: 45% 40%;
  }
  @media (max-width: 720px) {
    /* Keep the AUV in frame on narrow screens. */
    .hero-media img { object-position: 30% 35%; }
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, var(--color-bg) 0%, rgb(var(--shade-rgb) / 0.55) 35%, rgb(var(--shade-rgb) / 0) 70%),
      linear-gradient(to right, rgb(var(--shade-rgb) / 0.55), rgb(var(--shade-rgb) / 0) 60%);
  }

  .hero-content {
    --headline-size: clamp(2.6rem, 7.5vw, 6.25rem);
    padding-block: 8rem clamp(5rem, 12vh, 8rem);
  }
  @media (min-width: 721px) {
    /* Lift the text block 1.5 headline-heights up the photo; on phones it would cover the AUV. */
    .hero-content { padding-bottom: calc(clamp(5rem, 12vh, 8rem) + 1.5 * var(--headline-size)); }
  }

  h1 {
    font-size: var(--headline-size);
    margin: 0.2em 0 0.35em;
  }
  .line {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.25em;
  }
  .word { display: inline-block; }
  .accent {
    color: var(--color-accent);
    text-shadow: 0 0 32px rgb(var(--color-accent-rgb) / 0.55), 0 0 4px rgb(var(--color-accent-rgb) / 0.4);
  }

  .lead {
    max-width: 44ch;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    color: rgb(242 247 251 / 0.8);
    margin: 0 0 2rem;
  }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .vehicle-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin: 0 auto;
    padding-bottom: 2.5rem;
  }
  .vehicle-stats div {
    display: flex;
    flex-direction: column-reverse;
    padding-top: 1rem;
    border-top: 1px solid rgb(242 247 251 / 0.2);
    position: relative;
  }
  /* A short lit segment on each divider, like a light point on the line. */
  .vehicle-stats div::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 48px;
    height: 1px;
    background: var(--color-accent);
    box-shadow: var(--glow-sm);
  }
  .vehicle-stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking);
    font-size: clamp(1.6rem, 2.6vw, 2.25rem);
    line-height: 1.1;
    color: var(--color-accent);
    text-shadow: var(--glow);
  }
  .vehicle-stats dt { font-size: 0.9rem; color: rgb(242 247 251 / 0.7); }

  @media (min-width: 721px) {
    /* Sits along the bottom of the photo, inside the space left by lifting the text block. */
    .vehicle-stats { position: absolute; left: 0; right: 0; bottom: 0; }
  }
  @media (max-width: 720px) {
    .hero-content { padding-bottom: 2.5rem; }
    .vehicle-stats { grid-template-columns: repeat(2, 1fr); }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Focus pull: the photo starts soft and slightly zoomed, then sharpens. */
    .hero-media img {
      animation: focus-pull 2.6s var(--ease-out) both;
    }
    /* Headline words resolve one after another once the photo is mostly sharp. */
    .word {
      animation: word-focus 1.1s var(--ease-out) both;
      animation-delay: calc(0.7s + var(--i) * 0.14s);
    }
    .eyebrow, .lead, .actions {
      animation: fade-up 1s var(--ease-out) both;
    }
    .eyebrow { animation-delay: 0.5s; }
    .lead { animation-delay: 1.5s; }
    .actions { animation-delay: 1.7s; }
    .vehicle-stats div {
      animation: fade-up 1s var(--ease-out) both;
      animation-delay: calc(1.9s + var(--i) * 0.1s);
    }

    /* Gentle parallax as the hero scrolls away, where scroll-driven animations are supported. */
    @supports (animation-timeline: scroll()) {
      .hero-media {
        animation: drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
    }
  }

  @keyframes focus-pull {
    from { filter: blur(18px) saturate(0.6); transform: scaleX(-1) scale(1.12); }
    to { filter: none; transform: scaleX(-1); }
  }
  @keyframes word-focus {
    from { opacity: 0; filter: blur(12px); transform: translateY(0.25em); }
    to { opacity: 1; filter: none; transform: none; }
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes drift {
    to { transform: translateY(18vh) scale(1.05); }
  }
</style>
