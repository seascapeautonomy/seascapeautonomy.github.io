---
import { Image } from 'astro:assets';
import hero from '../assets/hero.png';

// Each headline word comes into focus in turn; each inner array is one line,
// and the second line takes the accent colour.
const lines = [
  ['Bringing', 'the', 'deep'],
  ['into', 'focus'],
];
let wordIndex = 0;
---

<section class="hero">
  <div class="hero-media">
    <Image
      src={hero}
      alt="Seeker AUV surveying a reef in Tonga"
      loading="eager"
      fetchpriority="high"
      widths={[800, 1400, 2000, 2304]}
      sizes="100vw"
    />
  </div>
  <div class="hero-shade"></div>

  <div class="container hero-content">
    <p class="eyebrow">Autonomous seafloor imaging</p>
    <h1>
      {
        lines.map((line, lineIndex) => (
          <span class:list={['line', { accent: lineIndex === lines.length - 1 }]}>
            {line.map((word) => (
              <span class="word" style={`--i: ${wordIndex++}`}>
                {word}
              </span>
            ))}
          </span>
        ))
      }
    </h1>
    <p class="lead">
      Robotic survey platforms and seafloor intelligence for defence, offshore infrastructure and
      environmental monitoring.
    </p>
    <div class="actions">
      <a class="button" href="#sectors">Explore capabilities</a>
      <a class="button ghost" href="#contact">Talk to us</a>
    </div>
  </div>

  <a class="scroll-cue" href="#sectors" aria-label="Scroll to content"><span></span></a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    overflow: hidden;
    color: #f2f7fb; /* sits on the photo, so stays light */
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Mirrored so the AUV sits on the right, heading towards the headline. */
    transform: scaleX(-1);
    object-position: 45% 40%;
  }
  @media (max-width: 720px) {
    /* Keep the AUV in frame on narrow screens. */
    .hero-media img { object-position: 30% 35%; }
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, var(--color-bg) 0%, rgb(2 8 18 / 0.55) 35%, rgb(2 8 18 / 0) 70%),
      linear-gradient(to right, rgb(2 8 18 / 0.55), rgb(2 8 18 / 0) 60%);
  }

  .hero-content { padding-block: 8rem clamp(5rem, 12vh, 8rem); }

  h1 {
    font-size: clamp(2.6rem, 7.5vw, 6.25rem);
    margin: 0.2em 0 0.35em;
  }
  .line {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.25em;
  }
  .word { display: inline-block; }
  .accent { color: var(--color-accent); }

  .lead {
    max-width: 44ch;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    color: rgb(242 247 251 / 0.8);
    margin: 0 0 2rem;
  }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    translate: -50% 0;
    width: 26px;
    height: 42px;
    border: 2px solid rgb(255 255 255 / 0.5);
    border-radius: 999px;
  }
  .scroll-cue span {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: #fff;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Focus pull: the photo starts soft and slightly zoomed, then sharpens. */
    .hero-media img {
      animation: focus-pull 2.6s var(--ease-out) both;
    }
    /* Headline words resolve one after another once the photo is mostly sharp. */
    .word {
      animation: word-focus 1.1s var(--ease-out) both;
      animation-delay: calc(0.7s + var(--i) * 0.14s);
    }
    .eyebrow, .lead, .actions {
      animation: fade-up 1s var(--ease-out) both;
    }
    .eyebrow { animation-delay: 0.5s; }
    .lead { animation-delay: 1.5s; }
    .actions { animation-delay: 1.7s; }
    .scroll-cue span { animation: scroll-dot 2s ease-in-out 2.5s infinite; }

    /* Gentle parallax as the hero scrolls away, where scroll-driven animations are supported. */
    @supports (animation-timeline: scroll()) {
      .hero-media {
        animation: drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
    }
  }

  @keyframes focus-pull {
    from { filter: blur(18px) saturate(0.6); transform: scaleX(-1) scale(1.12); }
    to { filter: none; transform: scaleX(-1); }
  }
  @keyframes word-focus {
    from { opacity: 0; filter: blur(12px); transform: translateY(0.25em); }
    to { opacity: 1; filter: none; transform: none; }
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes scroll-dot {
    0% { opacity: 0; transform: translateY(0); }
    30% { opacity: 1; }
    100% { opacity: 0; transform: translateY(14px); }
  }
  @keyframes drift {
    to { transform: translateY(18vh) scale(1.05); }
  }
</style>
