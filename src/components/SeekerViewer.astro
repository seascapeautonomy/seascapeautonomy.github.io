---
// The Seeker AUV in the 3D viewer, with a button per payload variant.
// A variant is enabled once its .glb file is in src/content/products/seeker-auv/;
// the first one with a model is shown by default.
import ModelViewer from './ModelViewer.astro';

interface Props {
  embedded?: boolean;
}

const models = import.meta.glob<string>('/src/content/products/seeker-auv/*.glb', {
  query: '?url',
  import: 'default',
  eager: true,
});
const model = (file: string) => models[`/src/content/products/seeker-auv/${file}`];

const variants = [
  { label: 'Imaging', description: 'Stereo imaging payload', src: model('seeker-imaging.glb') },
  { label: 'Sidescan', description: 'Sidescan sonar payload', src: model('seeker-sidescan.glb') },
];
---

<ModelViewer name="the Seeker AUV" variants={variants} embedded={Astro.props.embedded} />
