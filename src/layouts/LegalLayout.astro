---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout title={title}>
  <section class="container legal">
    <a class="back" href="/legal">← Legal</a>
    <article class="prose">
      <slot />
    </article>
  </section>
</BaseLayout>

<style>
  .legal { padding-block: 8rem 5rem; }
  .back { color: var(--color-muted); text-decoration: none; font-size: 0.9rem; }
  .back:hover { color: var(--color-accent); }
  .prose { max-width: 75ch; line-height: 1.7; }
  .prose :global(h1) { font-size: clamp(2.2rem, 5vw, 3.5rem); margin: 0.6em 0 0.8em; }
  .prose :global(h2) { font-size: 1.4rem; margin: 2em 0 0.6em; }
  .prose :global(h3) { font-size: 1.15rem; margin: 1.6em 0 0.5em; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 1em; color: rgb(232 240 248 / 0.88); }
  .prose :global(li) { margin-bottom: 0.4em; }
  .prose :global(a) { color: var(--color-accent); text-underline-offset: 3px; word-break: break-word; }
  .prose :global(strong) { color: var(--color-text); }
  .prose :global(table) { border-collapse: collapse; width: 100%; margin: 1.5em 0; font-size: 0.95rem; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--color-border); padding: 0.6em 0.8em; text-align: left; }
</style>
