---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemePicker from '../components/ThemePicker.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Seascape Autonomy',
  description = 'Autonomous underwater vehicles and seafloor imaging for defence, offshore infrastructure and environmental survey.',
} = Astro.props;
const pageTitle = title === 'Seascape Autonomy' ? title : `${title} | Seascape Autonomy`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&family=Sora:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600&family=Fraunces:opsz,wght@9..144,400;9..144,500&display=swap"
    />
    <title>{pageTitle}</title>
    <ClientRouter />
    {
      import.meta.env.DEV && (
        <script is:inline>
          // Dev-only: re-apply the previewed theme before paint and after each page swap.
          function applyPreviewTheme(doc) {
            let theme = new URLSearchParams(location.search).get('theme');
            try {
              if (theme) localStorage.setItem('preview-theme', theme);
              else theme = localStorage.getItem('preview-theme');
            } catch {}
            if (theme && theme !== 'abyss') doc.documentElement.dataset.theme = theme;
          }
          applyPreviewTheme(document);
          document.addEventListener('astro:before-swap', (e) => applyPreviewTheme(e.newDocument));
        </script>
      )
    }
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    {import.meta.env.DEV && <ThemePicker />}

    <script>
      // Reveal [data-reveal] elements on scroll; re-run after each client-side navigation.
      function setupReveal() {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15 },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
      }
      document.addEventListener('astro:page-load', setupReveal);
    </script>
  </body>
</html>
